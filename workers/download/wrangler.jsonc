// kivali.ai/download: sends the browser straight to the latest Kivali
// Desktop installer, so the website's download buttons never carry a
// version number. Three paths, all GET:
//
//   /download/macos     the macOS disk image (Apple silicon)
//   /download/windows   the Windows installer (x64)
//   /download           whichever of those fits the browser's platform;
//                       any other platform gets the release page
//
// Each release publishes latest.json at a fixed URL (the desktop app's
// update feed); this Worker reads it, keeps it in the edge cache for a few
// minutes and answers with a redirect. src/index.js has the details. No
// secrets, and nothing about the visitor is stored or logged.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kivali-download",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [
    { "pattern": "kivali.ai/download", "zone_name": "kivali.ai" },
    { "pattern": "kivali.ai/download/*", "zone_name": "kivali.ai" }
  ],
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  "vars": {
    // The update feed of the latest release: GitHub answers it with a
    // redirect to that release's own latest.json.
    "FEED_URL": "https://github.com/kivali-ai/kivali/releases/latest/download/latest.json",
    // Where the browser goes when the feed cannot be read, or the platform
    // has no installer.
    "RELEASES_URL": "https://github.com/kivali-ai/kivali/releases/latest"
  }
}
