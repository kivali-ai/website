// The sign-in relay for Kivali's public Google OAuth client.
//
// Every Kivali install shares one Google client whose id is baked into the
// server. Google issues a secret for that client and demands it at the token
// endpoint even with PKCE, so the secret lives here and nowhere else. Two
// routes, both under https://kivali.ai/oauth/google (the base every install
// is built with):
//
//   GET  /oauth/google/callback   Google's redirect URI for the client; bounces
//                                 the browser on to the install named in `state`,
//                                 with Google's code sealed for that install
//   POST /oauth/google/token      the code exchange; redeems a sealed code only for
//                                 its install, adds the secret, forwards it to
//                                 Google, and returns the id_token alone
//
// The secrets (GOOGLE_CLIENT_SECRET and RELAY_SEAL_KEY) are listed in `secrets`
// and put on the Worker by the deploy job. The contract the install relies on
// is docs/AUTH.md in the kivali repo; src/index.js follows it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kivali-oauth-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "kivali.ai/oauth/google/*", "zone_name": "kivali.ai" }],
  // Served only from kivali.ai. A preview version would run with this Worker's
  // secrets, so there are none.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs keeps every sign-in's log line (who, for which install, the
  // outcome) in the dashboard, with the invocation logs around them. Codes and
  // tokens are never logged.
  "observability": {
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "vars": {
    // The public client. Not a secret: it appears in every consent URL.
    "GOOGLE_CLIENT_ID": "508969299515-ol3l2a67ola8hfm2loru9ne8hksl8kfq.apps.googleusercontent.com",
    // The redirect URI registered on that client. The token route accepts a
    // request only for this value, and the callback route is served at it.
    "CALLBACK_URL": "https://kivali.ai/oauth/google/callback",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token"
  },
  // Per-IP rate limit on both routes: 60 requests a minute is far above any
  // real sign-in rate. Cloudflare's rate limiting binding is configured under
  // `unsafe` while it is in beta; src/index.js works without it.
  "unsafe": {
    "bindings": [
      { "name": "LIMITER", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
    ]
  }
}
