{
  "name": "kivali-website",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["workers/*"],
  "scripts": {
    "dev": "wrangler dev --config workers/site/wrangler.jsonc",
    "lint": "html-validate \"workers/*/public/**/*.html\"",
    "test": "node --test \"workers/*/src/*.test.js\" \"scripts/*.test.mjs\"",
    "check": "npm run lint && npm test && node scripts/workers.mjs check",
    "routes": "node scripts/workers.mjs routes"
  },
  "devDependencies": {
    "html-validate": "11.16.2",
    "wrangler": "4.147.0"
  }
}
